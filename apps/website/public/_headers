# Cloudflare Pages reads this file from the build output root; `public/` is copied there verbatim.
#
# Everything under `_astro/` is content-hashed by the build — bundled JS, self-hosted fonts and the
# pre-resized blog images — so the bytes behind a given URL can never change. Pages otherwise serves
# them as `max-age=1800, must-revalidate`, which forces a revalidation round trip every 30 minutes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
