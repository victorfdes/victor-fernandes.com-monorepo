---
import { SmartButton, SmartLink } from "@repo/ui"
import { createElement } from "react"
import { FaGithub, FaLinkedinIn, FaXTwitter } from "react-icons/fa6"
import { GoArrowRight } from "react-icons/go"
import { SiClaude, SiGooglegemini, SiOpenai, SiPerplexity } from "react-icons/si"
import { LINKS } from "utils/links"
import { isActivePath, PRIMARY_NAV } from "utils/nav"
import ScorecardStatus from "./ScorecardStatus"
import SonarStatus from "./SonarStatus"

const year = new Date().getFullYear()
const currentPath = Astro.url.pathname
const scorecardUrl = "https://scorecard.dev/viewer/?uri=github.com/victorfdes/victor-fernandes.com-monorepo"
const lighthouseMetrics = [
  { label: "Perf", value: "100" },
  { label: "A11y", value: "100" },
  { label: "Best", value: "100" },
  { label: "SEO", value: "100" },
]
const techStack = ["Astro", "React 19", "Tailwind v4", "TypeScript"]

// Each tile opens an AI assistant with a hiring-focused prompt about Victor.
// ChatGPT and Perplexity auto-submit via ?q=; Claude prefills the composer
// (visitor presses Enter); Gemini has no reliable prompt param, so it routes
// through Google's AI Mode.
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://victor-fernandes.com"
const aiPrompt = encodeURIComponent(
  `Summarise Victor's (${siteUrl}) skills and how he is positioned as a frontend expert. Highlight ways he could be an asset to my engineering team. His resume is at ${siteUrl}${LINKS.RESUME}.`
)
const askAi = [
  { name: "ChatGPT", href: `https://chatgpt.com/?q=${aiPrompt}`, Icon: SiOpenai, tile: "bg-black text-white" },
  { name: "Claude", href: `https://claude.ai/new?q=${aiPrompt}`, Icon: SiClaude, tile: "bg-[#d97757] text-white" },
  {
    name: "Perplexity",
    href: `https://www.perplexity.ai/search?q=${aiPrompt}`,
    Icon: SiPerplexity,
    tile: "bg-[#20808d] text-white",
  },
  {
    name: "Gemini",
    href: `https://www.google.com/search?udm=50&q=${aiPrompt}`,
    Icon: SiGooglegemini,
    tile: "bg-gradient-to-br from-[#4285f4] via-[#9b72cb] to-[#d96570] text-white",
  },
]
const socials = [
  { name: "LinkedIn profile", href: LINKS.LINKEDIN, Icon: FaLinkedinIn },
  { name: "GitHub profile", href: LINKS.GITHUB, Icon: FaGithub },
  { name: "X (formerly Twitter) profile", href: LINKS.X, Icon: FaXTwitter },
]
---

<footer class="mx-auto mt-20 box-border w-full text-left">
  <svg
    preserveAspectRatio="none"
    viewBox="0 0 402 12"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="h-3 w-full"
  >
    <path
      opacity="0.4"
      d="M0 12V7.371C16.0097 5.151 34.7027 4.154 52.93 4.571C76.5006 5.108 98.6005 7.902 122.208 8.321C146.944 8.757 171.634 6.633 195.305 4.795C218.51 2.995 241.636 2.307 265.454 3.487C277.564 4.087 288.854 5.271 300.445 6.421C331.479 9.5 372.855 13.429 402 6.753V12H0Z"
      class="fill-slate-200 dark:fill-cyan-700"></path>
    <path
      opacity="0.4"
      d="M0 12V10.419C4.355 8.308 9.2594 6.314 15.9761 4.795C33.3024 0.872999 55.275 0.9 75.2343 2.842C85.6696 3.857 95.3645 5.449 105.274 6.822C118.982 8.722 133.658 11.422 149.102 11.789C161.249 12.074 172.853 10.847 182.133 8.633C192.776 6.094 203.01 2.433 216.849 1.333C230.396 0.254 244.101 2.002 256.757 3.761C269.414 5.52 281.936 7.661 295.926 8.066C315.935 8.651 333.874 5.778 352.507 4.182C362.624 3.316 372.272 3.565 381.682 4.932C389.196 6.021 397.762 7.625 402 9.856V12H0Z"
      class="fill-slate-200 dark:fill-cyan-700"></path>
    <path
      opacity="0.4"
      class="fill-slate-200 dark:fill-cyan-700"
      d="M0 12V11.437C50.2265 6.1 105.22 4.868 159.403 7.743C173.808 8.507 187.62 9.755 202.152 10.389C221.917 11.252 239.833 9.165 257.615 6.849C277.357 4.278 296.81 2.476 318.652 3C347.64 3.7 376.426 7.571 402 11.481V12H0Z"
    ></path>
  </svg>

  <div
    class="bg-linear-to-b dark:from-cyan-700/78 from-slate-200 via-slate-100 to-slate-50 pt-4 dark:via-slate-800 dark:to-slate-900 dark:text-slate-200"
  >
    <div
      class="mx-auto grid w-full max-w-7xl gap-10 px-8 py-12 lg:grid-cols-[minmax(0,1fr)_minmax(28rem,1.15fr)] lg:gap-16"
    >
      <section aria-labelledby="footer-brand" class="flex flex-col gap-4">
        <div class="flex flex-col gap-5">
          <img
            src="/logo/victor-logo.svg"
            alt="Victor Fernandes - Logo"
            width={172}
            height={60}
            class="h-auto w-full max-w-48 invert transition duration-300 dark:invert-0"
          />
        </div>

        <div class="flex flex-col gap-6">
          <h2 id="footer-brand" class="m-0 pb-0 text-2xl font-light normal-case leading-[1.15] sm:text-[1.75rem]">
            Looking to <span class="text-highlight font-normal">scale your app</span> or ship a
            <span class="text-highlight font-normal">v1</span>?
          </h2>
          <SmartButton href={LINKS.CONTACT} intent="primary" arrow className="w-fit text-sm"> Let's Talk </SmartButton>
        </div>

        <nav
          aria-label="Footer navigation"
          class="flex flex-col gap-5 border-t border-zinc-300/70 pt-8 dark:border-zinc-700/60"
        >
          <h3 class="secondary-text m-0 pb-0 text-xs tracking-[0.28em]">Site Links</h3>
          <ul class="grid grid-cols-2 gap-x-6 gap-y-3.5 pl-0">
            {
              PRIMARY_NAV.map((item) => {
                const active = isActivePath(currentPath, item.href)
                return (
                  <li class="list-none">
                    <SmartLink
                      href={item.href}
                      aria-current={active ? "page" : undefined}
                      aria-keyshortcuts={String(item.shortcut)}
                      className={`group/nav flex items-center gap-2.5 no-underline transition-colors ${active ? "text-highlight" : "hover:text-cyan-700 dark:hover:text-cyan-300"}`}
                    >
                      <span
                        class={`kbd-key h-5 w-5 text-[11px] transition-colors ${active ? "border-cyan-600 text-cyan-700 dark:border-cyan-400 dark:text-cyan-300" : "secondary-text border-zinc-300 group-hover/nav:border-cyan-600/60 dark:border-zinc-700"}`}
                        aria-hidden="true"
                      >
                        {item.shortcut}
                      </span>
                      <span class="relative">
                        {item.label}
                        <span
                          class={`absolute -bottom-0.5 left-0 h-px w-full origin-left bg-current transition-transform duration-300 ${active ? "scale-x-100" : "scale-x-0 group-hover/nav:scale-x-100"}`}
                          aria-hidden="true"
                        />
                      </span>
                      <span
                        class={`text-sm transition-all duration-300 ${active ? "translate-x-0 opacity-100" : "-translate-x-1 opacity-0 group-hover/nav:translate-x-0 group-hover/nav:opacity-100"}`}
                        aria-hidden="true"
                      >
                        <GoArrowRight />
                      </span>
                    </SmartLink>
                  </li>
                )
              })
            }
          </ul>
        </nav>

        <div class="flex flex-col gap-5 border-t border-zinc-300/70 pt-8 dark:border-zinc-700/60">
          <h3 class="secondary-text m-0 pb-0 text-xs tracking-[0.28em]">Ask AI about Victor</h3>
          <ul class="flex flex-wrap gap-4 pl-0">
            {
              askAi.map((tool) => {
                const Icon = tool.Icon
                return (
                  <li class="list-none">
                    <a
                      href={tool.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Ask ${tool.name} about Victor Fernandes`}
                      class="group/ai flex w-16 flex-col items-center gap-2 no-underline"
                    >
                      <span
                        class={`flex h-12 w-12 items-center justify-center rounded-xl shadow-sm transition duration-300 group-hover/ai:-translate-y-1 group-hover/ai:shadow-lg ${tool.tile}`}
                      >
                        <Icon size={22} aria-hidden="true" />
                      </span>
                      <span class="secondary-text text-[10px] tracking-wide">{tool.name}</span>
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </div>
      </section>

      <section aria-labelledby="footer-system-status" class="shadow-hover-box bg-zinc-50/70 dark:bg-slate-950/40">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span aria-hidden="true" class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <h2 id="footer-system-status" class="m-0 pb-0 text-sm font-bold tracking-wider">Loads like a rocket?</h2>
          </div>
          <span class="chip-base w-fit uppercase">Workspaces/Turborepo</span>
        </div>

        <div class="border-color mt-8 grid overflow-hidden border-t md:auto-rows-fr md:grid-cols-2">
          <div
            class="border-color flex flex-col justify-between gap-2 p-4 md:border-r"
            data-testid="footer-status-cell"
          >
            <SmartLink
              href="https://github.com/victorfdes/victor-fernandes.com-monorepo/blob/main/lighthouserc.json"
              className="no-underline"
              showExternalIcon>Lighthouse Metrics</SmartLink
            >
            <dl class="flex flex-wrap items-start gap-x-4 gap-y-3">
              {
                lighthouseMetrics.map((metric) => (
                  <div class="grid justify-items-center gap-2">
                    <dt class="secondary-text order-2 text-[10px] uppercase">{metric.label}</dt>
                    <dd class="order-1 m-0 flex h-12 w-12 items-center justify-center rounded-full border-2 border-emerald-600 text-sm font-bold text-emerald-700 dark:border-emerald-400 dark:text-emerald-300">
                      {metric.value}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div
            class="border-color flex flex-col justify-between gap-2 border-t p-4 md:border-t-0"
            data-testid="footer-status-cell"
          >
            <SmartLink
              href="https://sonarcloud.io/project/overview?id=victorfdes_victor-fernandes.com-monorepo"
              className="no-underline"
              showExternalIcon>Sonar Analysis</SmartLink
            >
            <SonarStatus client:visible security="A" reliability="A" technicalDebt="0d" coverage="93.4%" />
          </div>

          <div
            class="border-color flex flex-col justify-between gap-2 border-t p-4 md:border-r"
            data-testid="footer-status-cell"
          >
            <SmartLink href={scorecardUrl} className="no-underline" showExternalIcon> OpenSSF Scorecard </SmartLink>
            <div class="flex grow items-center">
              <ScorecardStatus client:visible score={6.8} />
            </div>
          </div>

          <div class="border-color flex flex-col justify-between gap-2 border-t p-4" data-testid="footer-status-cell">
            <SmartLink
              href="https://github.com/victorfdes/victor-fernandes.com-monorepo"
              className="no-underline"
              showExternalIcon>View on Github</SmartLink
            >
            <ul class="mt-2 flex flex-wrap gap-2 pl-0">
              {techStack.map((tech) => <li class="chip-base list-none">{tech}</li>)}
            </ul>
          </div>
        </div>
      </section>
    </div>
    <hr />
    <div
      class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-8 py-6 text-sm md:flex-row md:items-center md:justify-between"
    >
      <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-1">
        <p class="secondary-text m-0">&copy; {year} Victor Fernandes</p>
        <span>&middot;</span>
        <SmartLink href={LINKS.PRIVACY_POLICY} className=""> Privacy Policy </SmartLink>
      </div>
      <div class="flex items-center gap-2">
        {
          socials.map((social) => {
            const Icon = social.Icon
            return (
              <SmartButton
                href={social.href}
                intent="tertiary"
                aria-label={social.name}
                className="h-9! w-9!"
                icon={createElement(Icon, { size: 20 })}
              />
            )
          })
        }
      </div>
    </div>
  </div>
</footer>
