---
import { SmartButton, WaveDivider, TextInput, SmartLink, DepthCard } from "@repo/ui"
import clsx from "clsx"
import { createElement } from "react"
import { FaDiscord, FaInstagram, FaXTwitter } from "react-icons/fa6"
import { TfiAlignRight } from "react-icons/tfi"
import Layout from "../layouts/Layout.astro"

const menuIcon = createElement(TfiAlignRight, { size: 24 })

// DepthCard takes whole elements for its action circles, so they are built here rather
// than inline — .astro templates can't express JSX children of a prop.
const socialActions = [
  createElement("button", { key: "instagram", type: "button", "aria-label": "Instagram" }, createElement(FaInstagram)),
  createElement("button", { key: "x", type: "button", "aria-label": "X" }, createElement(FaXTwitter)),
  createElement("button", { key: "discord", type: "button", "aria-label": "Discord" }, createElement(FaDiscord)),
]

const depthCardCta = createElement("button", { type: "button" }, "Open")
---

<Layout title="Victor Fernandes - Design system">
  <div class="absolute left-0 top-0 z-50 h-screen w-screen overflow-auto bg-white dark:bg-slate-900">
    <!-- Removed side-by-side for Astro, using standard Layout theme instead, or we can just render the content -->
    <div class="mx-auto max-w-4xl p-8">
      <h1>Heading One</h1>
      <h2>Heading Two</h2>
      <h3>Heading Three</h3>
      <h4>Heading Four</h4>
      <h5>Heading Five</h5>
      <h6>Heading Six</h6>

      <hr />

      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut{" "}
        <span class="font-semibold">labore et dolore</span> magna aliqua. Ut{" "}
        <span class="italic">enim ad minim veniam</span>, quis nostrud exercitation ullamco laboris nisi ut aliquip ex
        ea commodo consequat.
      </p>

      <p class="text-2xl">
        Lorem ipsum <span class="text-highlight">dolor sit amet</span>, consectetur adipiscing elit.
      </p>

      <p>
        Duis aute irure dolor in reprehenderit in voluptate velit esse remi{" "}
        <code>letter-spacing: var(--tracking-tighter);</code> duis cillum dolore eu{" "}
        <SmartLink href="https://example.com" showExternalIcon={true}> fugiat nulla pariatur </SmartLink>
        .
      </p>

      <hr />

      <h3 class="mt-4">Pre / Code blocks</h3>

      <pre>
        {`module.exports = {
  theme: {
    extend: {
      fontSize: {
        '90': '0.9em',
      }
    }
  }
}`}
      </pre>

      <hr />

      <h3 class="mt-4">Hover-Highlight blocks</h3>

      <div class={clsx("mt-6 p-8", "shadow-hover-box")}>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut{" "}
          <span class="font-semibold">labore et dolore</span> magna aliqua. Ut{" "}
          <span class="italic">enim ad minim veniam</span>, quis nostrud exercitation ullamco laboris nisi ut aliquip ex
          ea commodo consequat.
        </p>
      </div>

      <hr />
      <div>
        <h3 class="my-4">Depth cards</h3>
        <!-- Left at the default body colour: `secondary-text` (zinc-500) fails contrast against the
             zinc-300 background `code` carries. -->
        <p class="mb-8 text-base">
          Themed from a single free-form <code>color</code> prop. Hover or tab into a card to tilt it.
        </p>
        <div class="flex flex-wrap items-start gap-8">
          <DepthCard color="#00ffd6" title="Orb glass" actions={socialActions} cta={depthCardCta}>
            Soft pill body with stacked glass and concentric depth cues.
          </DepthCard>
          <DepthCard color="#22d3ee" title="Cyan surface" actions={socialActions} cta={depthCardCta}>
            The same shell in the site's own accent colour.
          </DepthCard>
          <DepthCard color="#a855f7" title="Chamfer cut" actions={socialActions} cta={depthCardCta}>
            Precision corners that read sharp against a dark UI.
          </DepthCard>
        </div>
      </div>

      <hr />
      <div>
        <h3 class="my-4">Buttons</h3>
        <div class="flex flex-wrap items-center gap-4">
          <SmartButton intent="primary"> Primary Button </SmartButton>
          <SmartButton intent="primary" arrow> Let's Talk </SmartButton>
          <SmartButton intent="primary" disabled> Disabled </SmartButton>
        </div>
        <h4 class="my-4">Secondary Buttons</h4>
        <div class="flex flex-wrap items-center gap-4">
          <SmartButton intent="secondary"> Secondary Button </SmartButton>
          <SmartButton intent="secondary" arrow> View resume </SmartButton>
          <SmartButton intent="secondary" disabled> Disabled </SmartButton>
        </div>
        <h4 class="my-4">Tertiary Buttons</h4>
        <div class="flex flex-wrap items-center gap-4">
          <SmartButton intent="tertiary"> Tertiary Button </SmartButton>
          <SmartButton intent="tertiary" disabled> Disabled </SmartButton>
        </div>
        <h4 class="my-4">Icon-only (circular)</h4>
        <div class="flex flex-wrap items-center gap-4">
          <SmartButton intent="primary" aria-label="Open menu" icon={menuIcon} />
          <SmartButton intent="secondary" aria-label="Open menu" icon={menuIcon} />
          <SmartButton intent="tertiary" aria-label="Open menu" icon={menuIcon} />
        </div>
      </div>

      <hr />
      <div>
        <h3 class="my-4">Dividers</h3>
        <WaveDivider />
      </div>

      <hr />
      <div>
        <h3 class="my-4">Input</h3>
        <TextInput
          value="name@example.com"
          readOnly
          containerClassName="h-12"
          aria-label="Email address"
          name="email"
        />
      </div>

      <div class="pt-20"></div>
    </div>
  </div>
</Layout>
