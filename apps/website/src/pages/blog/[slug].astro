---
import { SmartLink } from "@repo/ui"
import { getCollection, render } from "astro:content"
import { blogMdxComponents } from "../../components/blog/mdx-components"
import { TableOfContents } from "../../components/blog/TableOfContents"
import Layout from "../../layouts/Layout.astro"
import { formatBlogDate } from "../../utils/blog"
import { createBlogTaxonomyValue, estimateBlogReadingTime } from "../../utils/blog-content"
import { blogImage } from "../../utils/blog-images"
import { buildBlogPostingSchema } from "../../utils/structured-data"

export async function getStaticPaths() {
  const publishedPosts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())

  return publishedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: publishedPosts[index + 1] ?? null,
      nextPost: index > 0 ? (publishedPosts[index - 1] ?? null) : null,
    },
  }))
}

const { post, prevPost, nextPost } = Astro.props
const { Content, headings } = await render(post)

const publishedAt = post.data.date.toISOString().slice(0, 10)
const readingTime = estimateBlogReadingTime(post.body ?? "")
const categorySlug = createBlogTaxonomyValue(post.data.category).slug

const tocHeadings = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ id: heading.slug, text: heading.text, level: heading.depth as 2 | 3 }))

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://victor-fernandes.com").href
const articleSchema = buildBlogPostingSchema({
  url: canonicalUrl,
  title: post.data.title,
  description: post.data.description,
  image: post.data.featuredImage,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
})

// Pre-resized hero image (the post's LCP element); preload uses the same URLs the <img> requests.
const heroImage = await blogImage(post.data.featuredImage)
---

<Layout
  title={`${post.data.title} - Victor Fernandes`}
  description={post.data.description}
  image={post.data.featuredImage}
  ogType="article"
  preloadImage={heroImage.src}
  preloadImageSrcset={heroImage.srcSet}
  preloadImageSizes={heroImage.sizes}
  structuredData={articleSchema}
>
  <article class="w-full pb-[clamp(3.5rem,9vw,6rem)] pt-[clamp(2.5rem,7vw,4.5rem)]">
    <div class="">
      <SmartLink href="/blog" className="meta hover:text-accent no-underline transition-colors"
        >← Back to blog</SmartLink
      >
      <header class="mt-8">
        <div class="flex flex-wrap gap-2">
          <SmartLink
            className="tag hover:border-accent hover:text-accent no-underline transition-colors"
            href={`/blog/categories/${categorySlug}`}
          >
            {post.data.category}
          </SmartLink>
          {
            post.data.tags.map((tag) => (
              <SmartLink
                className="tag hover:border-accent hover:text-accent no-underline transition-colors"
                href={`/blog/tags/${createBlogTaxonomyValue(tag).slug}`}
              >
                #{tag}
              </SmartLink>
            ))
          }
        </div>
        <h1 class="text-ink mt-6 pb-0 text-4xl font-light normal-case leading-tight tracking-tight lg:text-5xl">
          {post.data.title}
        </h1>
        <p class="lede mt-5 max-w-[62ch] text-xl">{post.data.description}</p>
        <div class="meta mt-6 flex flex-wrap gap-x-3 gap-y-1">
          <time datetime={post.data.date.toISOString()}>Published {formatBlogDate(publishedAt)}</time>
          <span aria-hidden="true">/</span>
          <span>{readingTime}</span>
        </div>
      </header>
    </div>

    <div class="mt-8">
      {/* Decorative hero (the LCP element): the title above already names the post. */}
      <img
        src={heroImage.src}
        srcset={heroImage.srcSet}
        sizes={heroImage.srcSet ? heroImage.sizes : undefined}
        alt=""
        fetchpriority="high"
        decoding="async"
        class="border-line aspect-video w-full rounded-lg border object-cover"
      />
    </div>

    <TableOfContents headings={tocHeadings} className="mt-8 lg:hidden" client:idle />

    <div class="mx-auto mt-10 grid gap-8 lg:grid-cols-[240px_minmax(0,1fr)] lg:justify-center">
      <aside class="hidden lg:block">
        <TableOfContents headings={tocHeadings} className="sticky top-28" autoScroll client:idle />
      </aside>
      <div class="min-w-0">
        <div class="blog-prose">
          <Content components={blogMdxComponents} />
        </div>

        <nav aria-label="Adjacent posts" class="border-line mt-16 grid gap-4 border-t pt-8 sm:grid-cols-2">
          {
            prevPost ? (
              <SmartLink
                className="border-line hover:border-accent hover:text-accent rounded-lg border p-4 no-underline transition-colors"
                href={`/blog/${prevPost.id}`}
              >
                <span class="meta mb-1.5 block">Previous</span>
                {prevPost.data.title}
              </SmartLink>
            ) : (
              <span />
            )
          }
          {
            nextPost && (
              <SmartLink
                className="border-line hover:border-accent hover:text-accent rounded-lg border p-4 text-right no-underline transition-colors"
                href={`/blog/${nextPost.id}`}
              >
                <span class="meta mb-1.5 block">Next</span>
                {nextPost.data.title}
              </SmartLink>
            )
          }
        </nav>
      </div>
    </div>
  </article>
</Layout>
