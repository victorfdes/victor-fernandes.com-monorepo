---
import { SmartLink } from "@repo/ui"
import { BlogPostList } from "../../../components/blog/BlogPostList"
import PageHero from "../../../components/PageHero"
import Layout from "../../../layouts/Layout.astro"
import { loadPublishedPosts, groupPostsByTag } from "../../../utils/blog-collection"

export async function getStaticPaths() {
  const groups = groupPostsByTag(await loadPublishedPosts())
  return groups.map((group) => ({
    params: { tag: group.slug },
    props: { group },
  }))
}

const { group } = Astro.props
---

<Layout title={`Tag: #${group.label} - Victor Fernandes`} description={`Posts tagged ${group.label}.`}>
  <PageHero lead="Tag" emphasis={`#${group.label}`}>
    <SmartLink href="/blog/tags" className="meta hover:text-accent mt-9 inline-block no-underline transition-colors">
      ← All tags
    </SmartLink>
  </PageHero>

  <section class="section">
    <BlogPostList posts={group.posts} />
  </section>
</Layout>
