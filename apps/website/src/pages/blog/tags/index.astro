---
import { SmartLink } from "@repo/ui"
import { TaxonomyIndex } from "../../../components/blog/TaxonomyIndex"
import PageHero from "../../../components/PageHero"
import Layout from "../../../layouts/Layout.astro"
import { loadPublishedPosts, groupPostsByTag } from "../../../utils/blog-collection"

const groups = groupPostsByTag(await loadPublishedPosts())
---

<Layout title="Tags - Victor Fernandes" description="Browse blog posts by tag." robots="noindex,follow">
  <PageHero lead="Tags">
    <SmartLink href="/blog" className="meta hover:text-accent mt-9 inline-block no-underline transition-colors">
      ← Back to blog
    </SmartLink>
  </PageHero>

  <section class="section">
    <TaxonomyIndex groups={groups} hrefPrefix="/blog/tags" emptyMessage="No tags yet." />
  </section>
</Layout>
