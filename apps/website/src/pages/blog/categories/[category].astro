---
import { SmartLink } from "@repo/ui"
import { BlogPostList } from "../../../components/blog/BlogPostList"
import PageHero from "../../../components/PageHero"
import Layout from "../../../layouts/Layout.astro"
import { loadPublishedPosts, groupPostsByCategory } from "../../../utils/blog-collection"

export async function getStaticPaths() {
  const groups = groupPostsByCategory(await loadPublishedPosts())
  return groups.map((group) => ({
    params: { category: group.slug },
    props: { group },
  }))
}

const { group } = Astro.props
---

<Layout title={`Category: ${group.label} - Victor Fernandes`} description={`Posts in the ${group.label} category.`}>
  <PageHero lead="Category" emphasis={group.label}>
    <SmartLink
      href="/blog/categories"
      className="meta hover:text-accent mt-9 inline-block no-underline transition-colors"
    >
      ← All categories
    </SmartLink>
  </PageHero>

  <section class="section">
    <BlogPostList posts={group.posts} />
  </section>
</Layout>
