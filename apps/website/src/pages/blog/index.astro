---
import { SmartLink } from "@repo/ui"
import { BlogPostList } from "../../components/blog/BlogPostList"
import PageHero from "../../components/PageHero"
import SectionHead from "../../components/SectionHead"
import Layout from "../../layouts/Layout.astro"
import { loadPublishedPosts } from "../../utils/blog-collection"

const posts = await loadPublishedPosts()
---

<Layout
  title="Blog - Victor Fernandes"
  description="Notes on software engineering, frontend architecture, and building useful products."
>
  {
    /*
    Named slots rather than JSX-valued props: an .astro template cannot express JSX inside a
    prop expression, and Astro maps `slot="aside"` onto the component's `aside` prop for us.
  */
  }
  <PageHero lead="Blog">
    <p slot="aside" class="lede m-0">
      Engineering notes from projects, production decisions, and the bits worth remembering after the code ships.
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <SmartLink href="/blog/categories" className="pill no-underline">Browse categories</SmartLink>
      <SmartLink href="/blog/tags" className="pill no-underline">Browse tags</SmartLink>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="all-posts">
    <SectionHead id="all-posts">All posts</SectionHead>
    <BlogPostList posts={posts} />
  </section>
</Layout>
