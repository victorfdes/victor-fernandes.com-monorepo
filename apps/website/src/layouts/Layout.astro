---
// Self-hosted fonts. The @font-face rules are bundled via global.css (which imports
// the Fontsource stylesheets); preloading the primary body face here removes the
// flash of unstyled text — the font is fetched from our own origin before paint.
import mulishWoff2 from "@fontsource-variable/mulish/files/mulish-latin-wght-normal.woff2?url";
import { PUBLIC_STATIC_HOST_URL } from "astro:env/client";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer/Footer.astro";
import AppLayout from "./AppLayout";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Social preview image. Relative ("/og-default.png") or absolute (a blog post's featuredImage). */
  image?: string; // default below is an interim square icon — replace with a 1200×630 /og-default.png
  /** Open Graph type. "article" for blog posts, "website" otherwise. */
  ogType?: "website" | "article";
  /** Robots directive, e.g. "noindex,follow". Omitted when unset (page stays indexable). */
  robots?: string;
  /** JSON-LD object(s) injected as a <script type="application/ld+json"> in <head>. */
  structuredData?: object | object[];
  /** Upgrade the CDN dns-prefetch to a full preconnect — set on pages where a CDN image is the LCP element. */
  preconnectCdn?: boolean;
}

const {
  title = "Victor Fernandes - Fullstack Software Engineer",
  description = "Building Performant Frontends at Scale since 2012. Passionate about clean code, intuitive UX, and scalable architectures.",
  image,
  ogType = "website",
  robots,
  structuredData,
  preconnectCdn = false,
} = Astro.props;

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const siteOrigin = Astro.site ?? "https://victor-fernandes.com";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(image ?? "/android-chrome-512x512.png", siteOrigin);
const cdnOrigin = new URL(PUBLIC_STATIC_HOST_URL).origin;
// Escape "<" so a stray "</script>" inside any string can't break out of the JSON-LD tag.
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="en" class="font-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalURL} />

    <!--
      Resource hints. The CDN (r2.victor-fernandes.com) serves testimonial avatars and blog
      featured images; dns-prefetch is cheap everywhere, and image-LCP pages upgrade to a full
      preconnect. Self-hosted fonts are same-origin, so no font-origin preconnect is needed.
    -->
    <link rel="dns-prefetch" href={cdnOrigin} />
    {preconnectCdn && <link rel="preconnect" href={cdnOrigin} />}
    {measurementId && (
      <>
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.google-analytics.com" />
      </>
    )}

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Victor Fernandes" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Blog feed discovery -->
    <link rel="alternate" type="application/rss+xml" title="Victor Fernandes — Blog" href="/feed.xml" />

    {structuredDataJson && <script type="application/ld+json" is:inline set:html={structuredDataJson} />}

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Self-hosted fonts: preload the primary body face (see global.css for @font-face). -->
    <link rel="preload" href={mulishWoff2} as="font" type="font/woff2" crossorigin />
    <ClientRouter />

    <!--
      Theme initialization to prevent FOUC. Runs on first load AND on every
      `astro:after-swap` (view transitions), which fires after the new document
      is swapped in but before paint — without this the freshly server-rendered
      `<html>` would lose the `dark` class on each navigation.
    -->
    <script is:inline>
      function applyTheme() {
        const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const theme = stored
          ? stored
          : globalThis.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      }

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    {measurementId && (
      <>
        <script src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`} async></script>
        <script is:inline define:vars={{ measurementId }}>
          globalThis.dataLayer = globalThis.dataLayer || [];
          // gtag.js only treats a dataLayer entry as a command when it's the native
          // `arguments` object; a plain array (e.g. from a `(...args)` rest param) is
          // silently ignored, dropping every js/consent/config/event call. Must stay a
          // regular function — arrow functions have no `arguments`.
          globalThis.gtag = function () {
            globalThis.dataLayer.push(arguments);
          };
          globalThis.gtag("js", new Date());
          globalThis.gtag("consent", "default", {
            analytics_storage: "denied",
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
          });
          globalThis.gtag("config", measurementId, {
            send_page_view: false,
            anonymize_ip: true,
          });
        </script>
      </>
    )}

    <script>
      import { trackPageView } from "../utils/analytics";

      // Per-navigation page views (the old app used Next's `usePathname` effect).
      // `astro:page-load` fires on the first load and after every <ClientRouter />
      // transition; this bundled module registers the listener once and persists
      // across navigations. `trackPageView` no-ops unless analytics is configured
      // and the visitor's stored consent is "granted".
      document.addEventListener("astro:page-load", () => {
        trackPageView(`${location.pathname}${location.search}`);
      });
    </script>
  </head>
  <body class="background-base font-sans relative min-h-screen overflow-x-hidden">
    <!--
      A single hydrated island. AppLayout renders ThemeProvider internally so the
      header, off-canvas menu and theme toggle share one React tree (separate
      `client:load` islands would not share context). Slotted page markup is
      server-rendered and passed straight through as children.
    -->
    <AppLayout client:load>
      <main class="mx-auto box-border flex w-full max-w-7xl grow items-center px-8 py-4">
        <slot />
      </main>
      <Footer />
    </AppLayout>
  </body>
</html>
