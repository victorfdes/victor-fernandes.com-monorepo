{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["eslint"],
  "workspaces": {
    "apps/website": {
      "entry": ["src/pages/**/*.{astro,ts}", "e2e/**/*.spec.ts"],
      "project": "src/**/*.{ts,tsx,astro}",
      // Pulled in via CSS `@import` (global.css) / Astro asset imports, which knip
      // can't trace from JS — same reason tailwindcss is listed.
      "ignoreDependencies": ["tailwindcss"],
    },
    "packages/ui": {
      "project": "src/**/*.{ts,tsx}",
    },
  },
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "classMembers": "warn",
    "duplicates": "warn",
  },
}
